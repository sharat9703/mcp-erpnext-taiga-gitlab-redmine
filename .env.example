# devflow-mcp configuration
# Copy this file to .env (or to the path in DEVFLOW_ENV_FILE) and fill in your values

# Required: Your ERPNext instance URL
ERPNEXT_URL=

# Required: Your ERPNext username (usually email)
ERPNEXT_USERNAME=

# Required: Your ERPNext password
ERPNEXT_PASSWORD=

# Optional: TOTP secret for two-factor authentication
# Only needed if your ERPNext has 2FA enabled
ERPNEXT_TOTP_SECRET=

# GitLab Configuration (for Software Release feature)
# Required for creating software releases from GitLab merge requests
GITLAB_URL=
GITLAB_TOKEN=

# Redmine Configuration (for auto-fetching ticket titles)
# Optional - if not provided, you'll need to enter ticket titles manually
REDMINE_URL=
REDMINE_API_KEY=

# Taiga Configuration (for creating Taiga tasks and exporting them to ERP)
# Provide either TAIGA_TOKEN, or TAIGA_USER + TAIGA_PASS for password login.
TAIGA_HOST=
TAIGA_USER=
TAIGA_PASS=
# TAIGA_TOKEN=